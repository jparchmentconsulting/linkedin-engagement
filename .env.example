# Copy this file to .env and fill in your own keys, then restart the app.
# The dashboard runs without them; the two keys unlock pipeline runs
# (scraping + AI scoring). Both services have self-serve signup.

# Apify API token. Powers the LinkedIn post/engager/profile scraping.
# Get one at https://console.apify.com/settings/integrations (free account;
# actor usage is pay-per-result, a few cents per run at default settings).
APIFY_TOKEN=

# Anthropic API key. Powers lead scoring and DM drafting.
# Get one at https://console.anthropic.com/ (pay-as-you-go; scoring a lead
# costs a fraction of a cent).
ANTHROPIC_API_KEY=

# Optional overrides. The defaults are sensible; leave these unset.
# Model used for scoring and drafting:
# ANTHROPIC_MODEL=claude-sonnet-5
# How many leads are scored concurrently (1-20):
# SCORING_CONCURRENCY=6
# Hard per-post ceiling on scraped reactions/comments:
# ENGAGERS_PER_POST_CAP=2000
# Set to 0 to disable the background run worker:
# PIPELINE_WORKER=1
